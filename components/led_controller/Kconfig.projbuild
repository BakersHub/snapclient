menu "LED Controller Configuration"

    config ENABLE_LED_CONTROLLER
        bool "Enable LED Controller"
        default n
        help
            Enable sound-reactive LED controller for WS2812B/SK6812 strips.
            This adds minimal LED control via RMT with audio-reactive effects.

    config LED_GPIO_PIN
        int "LED Data GPIO Pin"
        depends on ENABLE_LED_CONTROLLER
        default 5
        help
            GPIO pin connected to the LED strip data line.
            Common pins: GPIO5, GPIO18, GPIO19, GPIO23

    config LED_NUM_LEDS
        int "Number of LEDs"
        depends on ENABLE_LED_CONTROLLER
        default 30
        range 1 300
        help
            Total number of LEDs in the strip.
            Keep this reasonable to avoid excessive memory usage.

    config LED_DEFAULT_BRIGHTNESS
        int "Default Brightness (0-255)"
        depends on ENABLE_LED_CONTROLLER
        default 128
        range 0 255
        help
            Default LED brightness on startup.
            0 = off, 255 = maximum brightness

    config LED_DEFAULT_EFFECT
        int "Default Effect"
        depends on ENABLE_LED_CONTROLLER
        default 1
        range 0 10
        help
            Default LED effect on startup.
            0=Off, 1=VU Meter, 2=Spectrum, 3=Pulse, 4=Wave, 5=Energy Bar,
            6=Rainbow Pulse, 7=Beat Flash, 8=Bass Pulse, 9=Stereo VU, 10=Solid

    config LED_DEFAULT_SENSITIVITY
        int "Default Audio Sensitivity (0-255)"
        depends on ENABLE_LED_CONTROLLER
        default 150
        range 0 255
        help
            Default audio sensitivity for reactive effects.
            Higher values = more sensitive to audio input.

    config LED_DEFAULT_SPEED
        int "Default Animation Speed (0-255)"
        depends on ENABLE_LED_CONTROLLER
        default 128
        range 0 255
        help
            Default animation speed for effects like pulse and wave.

endmenu
